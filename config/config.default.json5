// OpenForexAI — base configuration.
//
// This file is the base tree: every configurable area appears here so it is
// discoverable, with the values that are the same for most installations.
// It contains nothing personal — no broker accounts, no chat ids, no local
// paths, no tuned thresholds.
//
// Your own values go in config/config.json5, which is merged over this file
// and wins on every key it sets. Empty objects below are deliberate: they
// mark "this branch exists, fill it in your own config".
{
  // Controls merge semantics for selected paths when loading default + custom.
  // Listed paths are replaced wholesale instead of merged, so an entry removed
  // from config.json5 really disappears rather than reappearing from here.
  "ImportRules": {
    "Replace": [
      "agents",
      // The Telegram designer owns this set: a merge would make deleting a
      // rule shipped here impossible from the UI.
      "notifications.rules"
    ]
  },
  "system": {
    "version": "0.9.1",
    // INFO keeps the event log readable; DEBUG adds per-trigger diagnostics.
    "log_level": "INFO",
    // Hour offset of the broker's candle timestamps against UTC. Broker
    // specific — check yours before trusting the default.
    "broker_candle_utc_offset_hours": 3,
    // Hour offset the UI renders timestamps in. 0 = show UTC.
    "ui_utc": 0,
    // Economic calendar import. Both paths are machine specific; set them in
    // your own config or leave empty to switch the import off.
    "news": {
      "economic_calendar_file": "",
      "output_dir": "./data/news"
    },
    "management_api": {
      "host": "127.0.0.1",
      "port": 8765
    },
    "ui": {
      "dev_server": {
        "host": "127.0.0.1",
        "port": 5173
      },
      "monitor": {
        // Saved monitor filters are written here by the UI itself.
        "saved_filters": []
      }
    }
  },
  "database": {
    "backend": "sqlite",
    "sqlite_path": "./data/openforexai.db",
    "pool_size": 5
  },
  // Outbound notifications (Telegram today, further channels later).
  // Off until a bot token and at least one chat id are configured — set those
  // in your own config/config.json5, with the token coming from an environment
  // variable like the broker credentials, never written into a config file.
  "notifications": {
    "enable": false,
    // true = log what would be sent instead of sending. Use while testing.
    "dry_run": false,
    // Identical messages (same dedup_key, or same severity+title) are counted
    // instead of resent while one is this recent. The next real send reports
    // how many were suppressed.
    "dedup_window_seconds": 900,
    // Backstop against a flood of *distinct* messages; one notice is sent when
    // the cap is hit, then silence until the hour window frees up.
    "max_per_hour": 20,
    "telegram": {
      "bot_token": "${OFAI_TELEGRAM_BOT_TOKEN}",
      // Per severity, so routine info can live in a muted chat while critical
      // alerts land somewhere with notifications switched on. "default" is the
      // fallback when a severity has no own entry.
      "chat_ids": {
        // "default":  "123456789",
        // "info":     "123456789",
        // "warning":  "123456789",
        // "critical": "123456789"
      }
    },
    // Turn bus events into messages — adding a warning is config, not code.
    // Edit these in the UI under Config → Telegram; the matching routing entry
    // is derived automatically and must not be written by hand.
    //
    //   only_if   per field: a literal (equality), {"regex": "..."},
    //             {"contains": "..."}, {"ne": ...} or {"lt"/"lte"/"gt"/"gte": n}
    //   title /   templates; {placeholders} are filled from the event — nested
    //   template  paths work ({order.signal.pair}), plus envelope fields
    //             {event}, {source}, {instrument}. Missing fields render empty.
    //   dedup_by  fields that make the suppression key distinct, so e.g. EURUSD
    //             and USDJPY do not silence each other.
    //
    // Empty on purpose: which warnings you want is personal configuration.
    "rules": {}
  },
  "data": {
    "rolling_weeks": 4,
    "timeframes": [
      "M5"
    ],
    "indicator_cache_ttl_seconds": 30,
    "resample_bucket_offset_hours": 0
  },
  // Long-term, semantically searchable agent memory (LanceDB + BGE-M3).
  // Off by default because the embedding model is a large download.
  "semantic_memory": {
    "enable": false,
    "lancedb_path": "./data/semantic_memory",
    "embedding": {
      // "auto" picks CUDA when available, otherwise CPU.
      "device": "auto",
      "use_fp16": true
    },
    "search": {
      // Dense ANN hits fetched before sparse/ColBERT reranking.
      "dense_candidate_pool": 50,
      "default_top_k": 5,
      "max_top_k": 20
    }
  },
  // Rendered chart images for agents and the UI. Named configs are personal;
  // define yours in config/config.json5 or via the Chartshot editor.
  "chartshot": {
    "output_dir": "data/chartshots",
    "configs": {}
  },
  // LLM behind the in-UI assistants (routing, scripts, prompts).
  "llm_assistant": {
    // Empty = use the first configured LLM module.
    "provider": "",
    // Optional per-call overrides; omit to use the module's own settings.
    // "temperature": 0.2,
    // "max_tokens": 16384,
    "reasoning_effort": "low"
  },
  "modules": {
    "llm": {},
    "broker": {}
  },
  "snapshot_profiles": {},
  "decision_prompt_profiles": {},
  "event_composers": {},
  "agents": {}
}
