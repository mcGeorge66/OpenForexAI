  "event_composers": {
    "OXS_T-USDJPY-EC-RELAY": {
      "comment": "USDJPY relay for pre checking before BA agent",
      "enable": true,
      "broker": "mt5_oxs_t",
      "pair": "USDJPY",
      "timer": {
        "enabled": false,
        "interval_seconds": 60
      },
      "AnyCandle": 1,
      "event_triggers": [
        "analysis_result",
        "signal_generated"
      ],
      "session_filter": [],
      "tool_config": {
        "allowed_tools": [
          "get_open_positions"
        ],
        "max_tool_turns": 0,
        "script_timeout_seconds": 10
      },
      "pass_trigger": false,
      "script": "async def main(input, config, tools):\n    symbol = message.get(\"instrument\")\n    if not symbol:\n        log(\"EC guard: cannot extract instrument from message – signal BLOCKED\", level=\"error\", pin=True)\n        await emit(\"ec_guard_block\", {\"reason\": \"no_instrument_in_message\", \"input_keys\": list(input.keys())})\n        return None\n\n    resp = await tools.call(\"get_open_positions\", pair=symbol)\n\n    if not isinstance(resp, dict) or resp.get(\"error\") or \"pairs\" not in resp:\n        err = resp.get(\"error\") if isinstance(resp, dict) else repr(resp)\n        log(f\"{symbol}: EC guard: get_open_positions invalid response – signal BLOCKED. Error: {err}\", level=\"error\", pin=True)\n        await emit(\"ec_guard_block\", {\"reason\": \"tool_error\", \"pair\": symbol, \"error\": str(err)})\n        return None\n\n    pairs = resp.get(\"pairs\") or {}\n    pair_data = pairs.get(symbol, {})\n    count = pair_data.get(\"count\", 0)\n\n    if count == 0:\n        return input\n\n    log(f\"{symbol}: signal blocked - {count} position(s) already open\", level=\"info\", pin=True)\n    await emit(\"ec_guard_block\", {\"reason\": \"position_already_open\", \"pair\": symbol, \"open_count\": count})\n    return None",
      "config_json": "{}"
    },
    "OXS_T-USDJPY-EC-TRSLF": {
      "comment": "Trailing Stop-Loss adjusts the SL with each M5 candle if the distance to the ATR is too large, using the live broker price (not the M5 candle close). If the broker keeps rejecting the trail (e.g. 'Invalid stops') several times in a row while the position is in profit, closes it instead of leaving the stale stop in place.",
      "enable": true,
      "broker": "mt5_oxs_t",
      "pair": "USDJPY",
      "timer": {
        "enabled": false,
        "interval_seconds": 60
      },
      "AnyCandle": 1,
      "event_triggers": [
        "m5_candle_trigger"
      ],
      "session_filter": [],
      "tool_config": {
        "allowed_tools": [
          "calculate_indicator",
          "modify_order",
          "get_open_positions",
          "close_position",
          "assessment_memory"
        ],
        "max_tool_turns": 0,
        "script_timeout_seconds": 15
      },
      "pass_trigger": false,
      "script": "async def main(input, config, tools):\n    pair = (message.get(\"instrument\") or \"\").strip().upper()\n    candle = input.get(\"candle\") or {}\n\n    if input.get(\"is_null_candle\") or not pair:\n        return None\n\n    # -- Config ---------------------------------------------------------------\n    atr_period    = int(config.get(\"atr_period\", 14))\n    atr_timeframe = str(config.get(\"atr_timeframe\", \"M15\")).upper()\n    max_sl_atr    = float(config.get(\"max_sl_distance_atr\", 2.0))\n    target_sl_atr = float(config.get(\"target_sl_distance_atr\", 1.5))\n    max_failures  = int(config.get(\"max_consecutive_trail_failures\", 2))\n\n    # -- Open Positions -------------------------------------------------------\n    pos_resp = await tools.call(\"get_open_positions\", pair=pair)\n    pos_result = pos_resp or {}\n    orders = ((pos_result.get(\"pairs\") or {}).get(pair) or {}).get(\"orders\") or []\n\n    if not orders:\n        return None\n\n    adjustments = []\n\n    # -- Per-position consecutive-trail-failure counters, persisted across cycles\n    # via assessment_memory (plain \"position_id=count\" lines -- no import needed).\n    # Scoped per pair so EURUSD/USDJPY never share state.\n    mem_key = f\"trail_failures_{pair}\"\n    open_ids = {str(o.get(\"broker_position_id\")) for o in orders if o.get(\"broker_position_id\") is not None}\n    failure_counts = {}\n    mem_resp = await tools.call(\"assessment_memory\", agentid=mem_key, mode=\"get\")\n    raw_state = (mem_resp or {}).get(\"message\") or \"\"\n    for line in raw_state.splitlines():\n        if \"=\" not in line:\n            continue\n        pid, _, count_text = line.partition(\"=\")\n        if pid in open_ids and count_text.strip().lstrip(\"-\").isdigit():\n            failure_counts[pid] = int(count_text)\n\n    # -- M15 ATR for the SL-trailing phase --------------------------------------\n    atr_resp = await tools.call(\n        \"calculate_indicator\",\n        indicator=\"ATR\",\n        period=atr_period,\n        timeframe=atr_timeframe,\n        history=1,\n    )\n    atr_values = (atr_resp.get(\"values\") or [])\n    if not atr_values or atr_values[0].get(\"value\") is None:\n        return None\n\n    atr = float(atr_values[0][\"value\"])\n    if atr <= 0:\n        return None\n\n    # -- SL trailing only. Take-profit is never touched here -- it stays active\n    # alongside the trailing stop, so the trade can still close at its original\n    # target even while the stop is being trailed; the position closes at\n    # whichever of TP or the trailing SL is hit first. When a modify IS needed,\n    # the existing take-profit is re-affirmed explicitly in the same call\n    # instead of relying on the broker adapter's \"keep current value\" fallback\n    # for an omitted argument -- that fallback re-reads the broker's own current\n    # tp, which has been observed to read back as empty even when a real tp is\n    # set; protection must never be silently dropped by an SL-only modify.\n    max_dist = max_sl_atr * atr\n\n    for order in orders:\n        pos_id = order.get(\"broker_position_id\")\n        direction = str(order.get(\"direction\") or \"\").lower()\n        sl = order.get(\"stop_loss\")\n        tp = order.get(\"take_profit\")\n        # Live broker price from this same get_open_positions call -- NOT the M5\n        # trigger candle's close, which can be up to ~5 minutes stale. A stale\n        # price here means a newly-trailed stop can already be too close to the\n        # *real* live price by the time the modify request reaches the broker,\n        # which is exactly what caused repeated \"Invalid stops\" rejections (MT5\n        # retcode 10016) on a real EURUSD trade that kept moving in its favor\n        # while every trail attempt after the first bounced off the broker.\n        current_price = order.get(\"current_price\")\n        open_price = order.get(\"open_price\")\n\n        if pos_id is None or sl is None or current_price is None:\n            continue\n        pos_id = str(pos_id)\n\n        sl = float(sl)\n        price = float(current_price)\n        distance = abs(price - sl)\n        if distance <= max_dist:\n            continue\n\n        if direction == \"buy\":\n            new_sl = round(price - target_sl_atr * atr, 5)\n            improved = new_sl > sl\n        elif direction == \"sell\":\n            new_sl = round(price + target_sl_atr * atr, 5)\n            improved = new_sl < sl\n        else:\n            continue\n\n        if not improved:\n            log(\n                f\"SL_UPDATE_SKIPPED_NOT_IMPROVEMENT {pair} position={pos_id} \"\n                f\"old_sl={sl:.5f} proposed_sl={new_sl:.5f}\",\n                level=\"info\",\n            )\n            continue\n\n        mod_kwargs = {\n            \"position_id\": pos_id,\n            \"stop_loss\": new_sl,\n            \"reasoning\": (\n                f\"SL trailed: dist {distance:.5f} > max {max_dist:.5f} \"\n                f\"(M15 ATR {atr:.5f}, live price {price:.5f})\"\n            ),\n        }\n        try:\n            tp_value = float(tp) if tp is not None else 0.0\n        except (TypeError, ValueError):\n            tp_value = 0.0\n        if tp_value > 0:\n            mod_kwargs[\"take_profit\"] = tp_value\n\n        mod_resp = await tools.call(\"modify_order\", **mod_kwargs)\n        success = (mod_resp or {}).get(\"success\", False)\n        log(\n            f\"SL_TRAILED {pair} position={pos_id} old_sl={sl:.5f} \"\n            f\"new_sl={new_sl:.5f} success={success}\",\n            level=\"info\",\n            pin=True,\n        )\n        adjustments.append({\n            \"position_id\": pos_id,\n            \"action\": \"SL_TRAILED\",\n            \"direction\": direction,\n            \"old_sl\": sl,\n            \"new_sl\": new_sl,\n            \"atr\": atr,\n            \"success\": success,\n        })\n\n        if success:\n            failure_counts.pop(pos_id, None)\n            continue\n\n        # Fallback: the broker keeps rejecting the trail attempt (e.g. \"Invalid\n        # stops\"). If that happens several cycles in a row while the position is\n        # genuinely in profit, the old stop is stuck too far away to protect the\n        # gain -- better to lock the profit in now than keep retrying and risk\n        # giving it all back, which is exactly what happened to a real EURUSD\n        # trade this mechanism failed to protect (four rejections in a row,\n        # then a reversal turned the open profit into a closed loss).\n        failure_counts[pos_id] = failure_counts.get(pos_id, 0) + 1\n        if failure_counts[pos_id] < max_failures:\n            continue\n\n        in_profit = False\n        if open_price is not None:\n            open_price_f = float(open_price)\n            if direction == \"buy\":\n                in_profit = price > open_price_f\n            elif direction == \"sell\":\n                in_profit = price < open_price_f\n\n        if not in_profit:\n            continue\n\n        close_resp = await tools.call(\n            \"close_position\",\n            position_id=pos_id,\n            reasoning=(\n                f\"Emergency close: SL trail rejected by broker \"\n                f\"{failure_counts[pos_id]}x in a row while position is in \"\n                f\"profit (open {open_price}, live {price:.5f}).\"\n            ),\n        )\n        close_success = (close_resp or {}).get(\"success\", False)\n        log(\n            f\"EMERGENCY_CLOSE_AFTER_TRAIL_FAILURES {pair} position={pos_id} \"\n            f\"failures={failure_counts[pos_id]} success={close_success}\",\n            level=\"warning\",\n            pin=True,\n        )\n        adjustments.append({\n            \"position_id\": pos_id,\n            \"action\": \"EMERGENCY_CLOSE\",\n            \"direction\": direction,\n            \"failures\": failure_counts[pos_id],\n            \"success\": close_success,\n        })\n        if close_success:\n            failure_counts.pop(pos_id, None)\n\n    new_state = \"\\n\".join(f\"{pid}={count}\" for pid, count in failure_counts.items())\n    await tools.call(\"assessment_memory\", agentid=mem_key, mode=\"set\", message=new_state)\n\n    return {\"pair\": pair, \"adjustments\": adjustments} if adjustments else None\n",
      "config_json": "{\r\n  \"atr_period\": 14,\r\n  \"atr_timeframe\": \"M15\",\r\n  \"max_sl_distance_atr\": 2.0,\r\n  \"target_sl_distance_atr\": 1.5,\r\n  \"max_consecutive_trail_failures\": 2\r\n}"
    },
    "OXS_T-EURUSD-EC-RELAY": {
      "comment": "EURUSD relay for pre checking before BA agent",
      "enable": true,
      "broker": "mt5_oxs_t",
      "pair": "EURUSD",
      "timer": {
        "enabled": false,
        "interval_seconds": 60
      },
      "AnyCandle": 1,
      "event_triggers": [
        "analysis_result",
        "signal_generated"
      ],
      "session_filter": [],
      "tool_config": {
        "allowed_tools": [
          "get_open_positions",
          "assessment_memory"
        ],
        "max_tool_turns": 0,
        "script_timeout_seconds": 10
      },
      "pass_trigger": false,
      "script": "async def main(input, config, tools):\n    symbol = message.get(\"instrument\")\n    if not symbol:\n        log(\"EC guard: cannot extract instrument from message – signal BLOCKED\", level=\"error\", pin=True)\n        await emit(\"ec_guard_block\", {\"reason\": \"no_instrument_in_message\", \"input_keys\": list(input.keys())})\n        return None\n\n    resp = await tools.call(\"get_open_positions\", pair=symbol)\n\n    if not isinstance(resp, dict) or resp.get(\"error\") or \"pairs\" not in resp:\n        err = resp.get(\"error\") if isinstance(resp, dict) else repr(resp)\n        log(f\"{symbol}: EC guard: get_open_positions invalid response – signal BLOCKED. Error: {err}\", level=\"error\", pin=True)\n        await emit(\"ec_guard_block\", {\"reason\": \"tool_error\", \"pair\": symbol, \"error\": str(err)})\n        return None\n\n    pairs = resp.get(\"pairs\") or {}\n    pair_data = pairs.get(symbol, {})\n    count = pair_data.get(\"count\", 0)\n\n    if count == 0:\n        return input\n\n    log(f\"{symbol}: signal blocked - {count} position(s) already open\", level=\"info\", pin=True)\n    await emit(\"ec_guard_block\", {\"reason\": \"position_already_open\", \"pair\": symbol, \"open_count\": count})\n    return None",
      "config_json": "{}"
    },
    "OXS_T-EURUSD-EC-TRSLF": {
      "comment": "Trailing Stop-Loss adjusts the SL with each M5 candle if the distance to the ATR is too large, using the live broker price (not the M5 candle close). If the broker keeps rejecting the trail (e.g. 'Invalid stops') several times in a row while the position is in profit, closes it instead of leaving the stale stop in place.",
      "enable": true,
      "broker": "mt5_oxs_t",
      "pair": "EURUSD",
      "timer": {
        "enabled": false,
        "interval_seconds": 60
      },
      "AnyCandle": 1,
      "event_triggers": [
        "m5_candle_trigger"
      ],
      "session_filter": [],
      "tool_config": {
        "allowed_tools": [
          "get_open_positions",
          "calculate_indicator",
          "modify_order",
          "close_position",
