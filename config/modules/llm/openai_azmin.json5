{
  // OpenAI-compatible LLM module configuration — currently pointed at an Azure
  // AI Foundry v1 endpoint via base_url (https://<resource>.services.ai.azure.com/openai/v1).
  // No api-version/deployment-path quirks — Azure's v1 API is fully OpenAI-compatible,
  // routes by the `model` field just like real OpenAI. Module name kept as
  // "azure_azmin" (referenced by several agents in system.json5) even though the
  // adapter itself is now provider-agnostic "openai".
  // This file is managed by the module owner. The system only loads it by name.
  "adapter": "openai",
  "base_url":    "${OFAI_AZURE-ENDPOINT}",
  "model":       "${OFAI_AZURE-DEVELOPMENT}",
  "api_key":     "${OFAI_AZURE-KEY}",
  "reasoning_effort": "medium",
  "retry_attempts": 3,
  "retry_base_delay": 1.0,
  "timeout_seconds": 180,
  "sdk_max_retries": 0,
  "transcript_enabled": true,
  "transcript_path": "./logs/azmin_llm_transcript.log",
  "temperature": 1.0,
  "max_tokens": 16384
}
